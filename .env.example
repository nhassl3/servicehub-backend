# DB credentials
DB_USER=db_name
DB_PASSWORD=db_password
DB_NAME=db_name

# PASETO symmetric key — 64 hex chars (32 bytes)
PASETO_KEY=some_64_chars_alphabet_numbers

# Redis password
REDIS_USER=redis_user
REDIS_USER_PASSWORD=redis_user_password
REDIS_PASSWORD=redis_storage_password

# MinIO credentials
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_ROOT_USER=minio_user # compare with access_key
MINIO_ROOT_PASSWORD=minio_password # compare with sescret_key
MINIO_PUBLIC_URL=http://your_computer_ip_or_vps_ip:9000/

# SMTP Client. Given from provider
SMTP_USERNAME=smtp_username
SMTP_PASSWORD=smtp_password
SMTP_FROM=some@email.address

# Kafka UI Auth
KAFKA_UI_AUTH_USER=kafka_ui_username
KAFKA_UI_AUTH_PASSWORD=kafka_ui_password

# ELS (FTS)
ELS_USERNAME=elasticsearch_username
ELS_PASSWORD=elasticsearch_password
KIBANA_PASSWORD=kibana_password

# Clickhouse
CLICKHOUSE_DB=clickhouse_db_name
CLICKHOUSE_USER=clickhouse_username
CLICKHOUSE_PASSWORD=clickhouse_password


# oAuth 2.0 - Yandex issuer
OAUTH_CLIENT_ID=client_id_given_from_provider
OAUTH_CLIENT_SECRET=client_secret_given_from_provider
ENDPOINT_APP=http://client:port/callback/endpoint
